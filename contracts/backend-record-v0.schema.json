{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interlanguage:schema:openstax-precalculus-2e-modular-backend:0.1.0",
  "title": "OpenStax Precalculus 2e modular-backend record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "entity",
    "id",
    "source_local_id",
    "source_label",
    "parent_id",
    "order",
    "path",
    "resource_id",
    "edition_id",
    "source_locator",
    "source_sha256",
    "language",
    "locale",
    "translation_state",
    "source_record_id",
    "provenance",
    "concept_ids",
    "prerequisite_ids",
    "rights_id",
    "status",
    "timestamp",
    "responsible_workflow",
    "supersedes_id",
    "qa_event_ids",
    "artifact_ids",
    "data"
  ],
  "properties": {
    "schema": {"const": "openstax-precalculus-2e-modular-backend"},
    "schema_version": {"const": "0.1.0"},
    "entity": {
      "enum": [
        "program", "course", "resource", "edition", "unit", "concept",
        "segment", "term", "asset", "relation", "rights", "qa_event",
        "artifact", "correction"
      ]
    },
    "id": {"type": "string", "pattern": "^urn:interlanguage:"},
    "source_local_id": {"type": ["string", "null"]},
    "source_label": {"type": ["string", "null"]},
    "parent_id": {"type": ["string", "null"]},
    "order": {"type": ["integer", "null"], "minimum": 0},
    "path": {"type": "array", "items": {"type": "string"}},
    "resource_id": {"type": ["string", "null"]},
    "edition_id": {"type": ["string", "null"]},
    "source_locator": {"type": ["string", "null"]},
    "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "language": {"type": "string"},
    "locale": {"type": "string"},
    "translation_state": {
      "type": ["string", "null"],
      "enum": [
        null,
        "source_frozen",
        "queued",
        "draft",
        "translated",
        "structurally_verified",
        "mathematically_reviewed",
        "language_reviewed",
        "built",
        "visually_checked",
        "published",
        "blocked",
        "superseded"
      ]
    },
    "source_record_id": {"type": ["string", "null"]},
    "provenance": {"type": "object"},
    "concept_ids": {"type": "array", "items": {"type": "string"}},
    "prerequisite_ids": {"type": "array", "items": {"type": "string"}},
    "rights_id": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "timestamp": {"type": "string", "pattern": "Z$"},
    "responsible_workflow": {"type": "string"},
    "supersedes_id": {"type": ["string", "null"]},
    "qa_event_ids": {"type": "array", "items": {"type": "string"}},
    "artifact_ids": {"type": "array", "items": {"type": "string"}},
    "data": {"type": "object"}
  }
}
