 --></exercise><exercise id="fs-id3268850"><problem id="fs-id3268851">
<table id="fs-id2427395" summary="Dua baris, lima kolom. Tabel memuat pasangan terurut berikut: (x,y), (0,4), (1,0), (2,16), (3,-40)." class="unnumbered"><label />
<tgroup cols="5"><colspec colnum="1" colname="c1" />
   <colspec colnum="2" colname="c2" />
   <colspec colnum="3" colname="c3" />
   <colspec colnum="4" colname="c4" />
   <colspec colnum="5" colname="c5" />
   <tbody>
    <row>
     <entry align="center"><emphasis> <m:math>
      <m:mi>x</m:mi>
     </m:math>
     </emphasis></entry>
     <entry align="center">0</entry>
     <entry align="center">1</entry>
     <entry align="center">2</entry>
     <entry align="center">3</entry>
    </row>

    <row>
     <entry align="center"><emphasis> <m:math>
      <m:mi>y</m:mi>
     </m:math>
     </emphasis></entry>
     <entry align="center">4</entry>
     <entry align="center">0</entry>
     <entry align="center">16</entry>
     <entry align="center">-40</entry>
    </row>
   </tbody>

</tgroup>
</table></problem>
<solution id="eip-idm518252400">
<para id="eip-idm518252144"> <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:msup>
    <m:mrow>
     <m:mrow><m:mo>(</m:mo><m:mo>–</m:mo>
      <m:mn>2</m:mn>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
    <m:mi>x</m:mi>
   </m:msup>
   <m:mo>+</m:mo><m:mn>8</m:mn><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
    <m:mrow>
     <m:mfrac><m:mrow>
      <m:mi>π</m:mi>
</m:mrow>
      <m:mn>2</m:mn>

     </m:mfrac>
 <m:mi>x</m:mi>
    </m:mrow>
    <m:mo>)</m:mo></m:mrow>
  </m:mrow>
 </m:math>

</para></solution></exercise><para id="fs-id2246932">Untuk latihan berikut, tentukan fungsi berbentuk <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:msup>
    <m:mi>b</m:mi>
    <m:mi>x</m:mi>
   </m:msup>
   <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
    <m:mrow>
     <m:mfrac>
      <m:mi>π</m:mi>
      <m:mn>2</m:mn>
     </m:mfrac>
     <m:mi>x</m:mi>
    </m:mrow>
    <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mi>c</m:mi>
  </m:mrow>
 </m:math> yang sesuai dengan data yang diberikan.</para><exercise id="fs-id1673269"><problem id="fs-id1673270"><table id="fs-id1673271" summary="Dua baris, lima kolom. Tabel memuat pasangan terurut berikut: (x,y), (0,11), (1,3), (2,1), (3,3)." class="unnumbered"><label />
  <title />
  <tgroup cols="5">
