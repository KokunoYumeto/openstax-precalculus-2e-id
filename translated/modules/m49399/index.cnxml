     <entry align="center">11</entry>
     <entry align="center">3</entry>
     <entry align="center">1</entry>
     <entry align="center">3</entry>
    </row>
   </tbody>
  </tgroup>
 </table></problem>
<!--<solution id="fs-id3639999">
 <para id="fs-id3640001"> <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn><m:msup>
    <m:mrow>
     <m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mn>1</m:mn>
        <m:mn>2</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
    <m:mi>x</m:mi>
   </m:msup>
   <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
    <m:mrow>
     <m:mfrac>
      <m:mi>&#960;</m:mi>
      <m:mn>2</m:mn>
     </m:mfrac>
     <m:mi>x</m:mi>
    </m:mrow>
    <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mn>3</m:mn>
  </m:mrow>
 </m:math>
 </para>
</solution>--></exercise><exercise id="fs-id2909364"><problem id="fs-id2909365"><table id="fs-id2909366" summary="Dua baris, lima kolom. Tabel memuat pasangan terurut berikut: (x,y), (0,4), (1,1), (2,-11), (3,1)." class="unnumbered"><label />
  <title />
  <tgroup cols="5">
   <colspec colnum="1" colname="c1" />
   <colspec colnum="2" colname="c2" />
   <colspec colnum="3" colname="c3" />
   <colspec colnum="4" colname="c4" />
   <colspec colnum="5" colname="c5" />
   <tbody>
    <row>
     <entry align="center"><emphasis> <m:math>
      <m:mi>x</m:mi>
     </m:math>
     </emphasis></entry>
     <entry align="center">0</entry>
     <entry align="center">1</entry>
     <entry align="center">2</entry>
     <entry align="center">3</entry>
    </row>

    <row>
     <entry align="center"><emphasis> <m:math>
      <m:mi>y</m:mi>
     </m:math>
     </emphasis></entry>
     <entry align="center">4</entry>
     <entry align="center">1</entry>
     <entry align="center">−11</entry>
     <entry align="center">1</entry>
    </row>
   </tbody>
  </tgroup>
 </table></problem>
<solution id="eip-idm1275027760">
<para id="eip-idm1275032048">
 <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:msup>
    <m:mrow>
     <m:mrow><m:mo>(</m:mo>
      <m:mn>2</m:mn>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
    <m:mi>x</m:mi>
   </m:msup>
   <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
    <m:mrow>
     <m:mfrac>
      <m:mi>π</m:mi>
<m:mrow>
      <m:mn>2</m:mn>
     <m:mi>x</m:mi></m:mrow>
     </m:mfrac>

    </m:mrow>
    <m:mo>)</m:mo></m:mrow>
  </m:mrow>
<m:mo>+</m:mo><m:mn>1</m:mn>
 </m:math>


</para>
</solution></exercise></section>
</section>
<section id="fs-id1817053" class="review-exercises"><title>Latihan Tinjauan Bab</title><section id="fs-id1817056"><title><link document="m49393">Menyederhanakan dan Memverifikasi Identitas Trigonometri</link></title><para id="fs-id1817061">Untuk latihan berikut, tentukan semua solusi eksak yang ada pada interval <m:math>
    <m:mrow>
     <m:mrow><m:mo>[</m:mo> <m:mrow>
      <m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi>
     </m:mrow> <m:mo>)</m:mo></m:mrow><m:mo>.</m:mo>
    </m:mrow>
   </m:math>
   </para>
   <exercise id="fs-id2814310"><problem id="fs-id2814311"><para id="fs-id2814312"> <m:math>
    <m:mrow>
     <m:msup>
      <m:mrow>
       <m:mi>csc</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>t</m:mi><m:mo>=</m:mo><m:mn>3</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
   <solution id="fs-id2738088">
    <para id="fs-id2738090"> <m:math>
     <m:mrow>
      <m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mrow>
        <m:mo>−</m:mo><m:mn>1</m:mn>
       </m:mrow>
      </m:msup>
      <m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:msqrt>
           <m:mn>3</m:mn>
          </m:msqrt>

         </m:mrow>
         <m:mn>3</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>π</m:mi><m:mo>−</m:mo><m:msup>
        <m:mrow>
         <m:mi>sin</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mo>−</m:mo><m:mn>1</m:mn>
        </m:mrow>
       </m:msup>
      <m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:msqrt>
           <m:mn>3</m:mn>
          </m:msqrt>

         </m:mrow>
         <m:mn>3</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>π</m:mi><m:mo>+</m:mo><m:msup>
        <m:mrow>
         <m:mi>sin</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mo>−</m:mo><m:mn>1</m:mn>
        </m:mrow>
       </m:msup>
      <m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:msqrt>
           <m:mn>3</m:mn>
          </m:msqrt>

         </m:mrow>
         <m:mn>3</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi><m:mo>−</m:mo><m:msup>
        <m:mrow>
         <m:mi>sin</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mo>−</m:mo><m:mn>1</m:mn>
        </m:mrow>
       </m:msup>
      <m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:msqrt>
           <m:mn>3</m:mn>
          </m:msqrt>

         </m:mrow>
         <m:mn>3</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
     </m:mrow>
    </m:math>
    </para>
</solution></exercise>
<exercise id="fs-id2335221"><problem id="fs-id2335222"><para id="fs-id3884655"> <m:math>
 <m:mrow>
  <m:msup>
   <m:mrow>
    <m:mi>cos</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac>
   <m:mn>1</m:mn>
   <m:mn>4</m:mn>
  </m:mfrac>

 </m:mrow>
</m:math>
</para></problem></exercise>
   <exercise id="fs-id3884657"><problem id="fs-id3884658"><para id="fs-id3884660"> <m:math>
 <m:mrow>
  <m:mn>2</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>θ</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>1</m:mn>
 </m:mrow>
</m:math>
</para></problem>
   <solution id="fs-id1686398">
    <para id="fs-id1686400"> <m:math>
 <m:mrow>
  <m:mfrac>
   <m:mrow>
    <m:mn>7</m:mn><m:mi>π</m:mi>
   </m:mrow>
   <m:mn>6</m:mn>
  </m:mfrac>
  <m:mo>,</m:mo><m:mfrac>
   <m:mrow>
    <m:mn>11</m:mn><m:mi>π</m:mi>
   </m:mrow>
   <m:mn>6</m:mn>
  </m:mfrac>

 </m:mrow>
</m:math>
</para></solution></exercise>
   <exercise id="fs-id1561562"><problem id="fs-id1561563"><para id="fs-id1561564"> <m:math>
 <m:mrow>
  <m:mi>tan</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mo>−</m:mo><m:mi>x</m:mi>
   </m:mrow>
  <m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mn>0</m:mn>
 </m:mrow>
</m:math>
</para></problem></exercise>
   <exercise id="fs-id1561566"><problem id="fs-id1561567"><para id="fs-id3633665"> <m:math>
    <m:mrow>
     <m:mn>9</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>ω</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>ω</m:mi>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2571914">
     <para id="fs-id2571916"> <m:math>
      <m:mrow>
       <m:msup>
        <m:mrow>
         <m:mi>sin</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mo>−</m:mo><m:mn>1</m:mn>
        </m:mrow>
       </m:msup>
       <m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mfrac>
          <m:mn>1</m:mn>
          <m:mn>4</m:mn>
         </m:mfrac>

        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>π</m:mi><m:mo>−</m:mo><m:msup>
         <m:mrow>
          <m:mi>sin</m:mi>
         </m:mrow>
         <m:mrow>
          <m:mo>−</m:mo><m:mn>1</m:mn>
         </m:mrow>
        </m:msup>
       <m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mfrac>
          <m:mn>1</m:mn>
          <m:mn>4</m:mn>
         </m:mfrac>

        </m:mrow>
        <m:mo>)</m:mo></m:mrow>
      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2336890"><problem id="fs-id1986206"><para id="fs-id1986207"> <m:math>
    <m:mrow>
     <m:mn>1</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mspace width="0.3em" /><m:mi>tan</m:mi><m:mo stretchy="false">(</m:mo><m:mi>ω</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:msup>
      <m:mrow>
       <m:mi>tan</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mo stretchy="false">(</m:mo><m:mi>ω</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem></exercise>


   <para id="fs-id3483090">Untuk latihan berikut, gunakan identitas dasar untuk menyederhanakan ekspresi.</para>
   <exercise id="fs-id3483093" class="material-set-2"><problem id="fs-id3483094"><para id="fs-id3483095"> <m:math>
    <m:mrow>
     <m:mi>sec</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac>
      <m:mn>1</m:mn>
      <m:mrow>
       <m:mi>sec</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
      </m:mrow>
     </m:mfrac>

    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2177520">
     <para id="fs-id2177522"> <m:math>
      <m:mn>1</m:mn>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2177531" class="material-set-2"><problem id="fs-id2177532"><para id="fs-id2177533"> <m:math>
    <m:mrow>
     <m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>3</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
      <m:mrow>
       <m:mi>cos</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
    </m:mrow>
   </m:math>
   </para></problem></exercise>

   <para id="fs-id1875805">Untuk latihan berikut, tentukan apakah identitas yang diberikan setara.</para>
   <exercise id="fs-id1875808" class="material-set-2"><problem id="fs-id1875809"><para id="fs-id1875810"> <m:math>
    <m:mrow>
     <m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
      <m:mrow>
       <m:mi>sec</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mfrac>
      <m:mrow>
       <m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mn>1</m:mn><m:mo>−</m:mo><m:msup>
          <m:mrow>
           <m:mi>cos</m:mi>
          </m:mrow>
          <m:mn>2</m:mn>
         </m:msup>
         <m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:mn>1</m:mn><m:mo>+</m:mo><m:msup>
           <m:mrow>
            <m:mi>cos</m:mi>
           </m:mrow>
           <m:mn>2</m:mn>
          </m:msup>
          <m:mi>x</m:mi>
         </m:mrow>
         <m:mo>)</m:mo></m:mrow>
      </m:mrow>
      <m:mrow>
       <m:msup>
        <m:mrow>
         <m:mi>cos</m:mi>
        </m:mrow>
        <m:mn>2</m:mn>
       </m:msup>
       <m:mi>x</m:mi>
      </m:mrow>
     </m:mfrac>

    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id1938474">
     <para id="fs-id1938476">Ya</para>
    </solution></exercise>
   <exercise id="fs-id1938480" class="material-set-2"><problem id="fs-id1938482"><para id="fs-id1938483"> <m:math>
 <m:mrow>
  <m:msup>
   <m:mrow>
    <m:mi>tan</m:mi>
   </m:mrow>
   <m:mn>3</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
   <m:mrow>
    <m:mi>csc</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
   <m:mrow>
    <m:mi>cot</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn>
 </m:mrow>
</m:math>
</para></problem></exercise>

  </section><section id="fs-id1617465"><title><link document="m49395">Identitas Jumlah dan Selisih</link></title><para id="fs-id1672272">Untuk latihan berikut, tentukan nilai eksak.</para>
   <exercise id="fs-id1672275" class="material-set-2"><problem id="fs-id1672276"><para id="fs-id1672277"> <m:math>
    <m:mrow>
     <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>7</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mn>12</m:mn>
        </m:mrow>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id1868073">
     <para id="fs-id1868075"> <m:math>
      <m:mrow>
       <m:mo>−</m:mo><m:mn>2</m:mn><m:mo>−</m:mo><m:msqrt>
        <m:mn>3</m:mn>
       </m:msqrt>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2165220" class="material-set-2"><problem id="fs-id2165222"><para id="fs-id2165223"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>25</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mn>12</m:mn>
        </m:mrow>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id2439803" class="material-set-2"><problem id="fs-id2439804"><para id="fs-id2439805"> <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:msup>
        <m:mrow>
         <m:mn>70</m:mn>
        </m:mrow>
        <m:mo>∘</m:mo>
       </m:msup>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:msup>
         <m:mrow>
          <m:mn>25</m:mn>
         </m:mrow>
         <m:mo>∘</m:mo>
        </m:msup>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:msup>
          <m:mrow>
           <m:mn>70</m:mn>
          </m:mrow>
          <m:mo>∘</m:mo>
         </m:msup>

        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:msup>
           <m:mrow>
            <m:mn>25</m:mn>
           </m:mrow>
           <m:mo>∘</m:mo>
          </m:msup>

         </m:mrow>
         <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2259234">
     <para id="fs-id2259236"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:msqrt>
          <m:mn>2</m:mn>
         </m:msqrt>

        </m:mrow>
        <m:mn>2</m:mn>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2590534" class="material-set-2"><problem id="fs-id2590535"><para id="fs-id2449023"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:msup>
        <m:mrow>
         <m:mn>83</m:mn>
        </m:mrow>
        <m:mo>∘</m:mo>
       </m:msup>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:msup>
         <m:mrow>
          <m:mn>23</m:mn>
         </m:mrow>
         <m:mo>∘</m:mo>
        </m:msup>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:msup>
          <m:mrow>
           <m:mn>83</m:mn>
          </m:mrow>
          <m:mo>∘</m:mo>
         </m:msup>

        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:msup>
           <m:mrow>
            <m:mn>23</m:mn>
           </m:mrow>
           <m:mo>∘</m:mo>
          </m:msup>

         </m:mrow>
         <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem></exercise>

   <para id="fs-id2121606">Untuk latihan berikut, buktikan identitasnya.</para>
   <exercise id="fs-id2121610" class="material-set-2"><problem id="fs-id2121611"><para id="fs-id2121612"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mn>4</m:mn><m:mi>x</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>3</m:mn><m:mi>x</m:mi>
       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:msup>
        <m:mrow>
         <m:mi>sin</m:mi>
        </m:mrow>
        <m:mn>2</m:mn>
       </m:msup>
     <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
      <m:mrow>
       <m:mi>cos</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi>
    </m:mrow>
   </m:math>
    </para></problem>
    <solution id="fs-id1711251"><para id="fs-id1711253"> <m:math>
 <m:mrow>
  <m:mtable columnalign="left">
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>4</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>3</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mi>x</m:mi><m:mo>=</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:msup>
       <m:mrow>
        <m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:msup>
           <m:mrow>
            <m:mi>cos</m:mi>
           </m:mrow>
           <m:mn>2</m:mn>
          </m:msup>
          <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
           <m:mrow>
            <m:mi>sin</m:mi>
           </m:mrow>
           <m:mn>2</m:mn>
          </m:msup>
          <m:mi>x</m:mi>
         </m:mrow>
        <m:mo>)</m:mo></m:mrow>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:msup>
         <m:mrow>
          <m:mi>cos</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:msup>
        <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
         <m:mrow>
          <m:mi>sin</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:msup>
        <m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mn>2</m:mn>
      <m:mo>)</m:mo></m:mrow><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:msup>
       <m:mrow>
        <m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:msup>
           <m:mrow>
            <m:mi>cos</m:mi>
           </m:mrow>
           <m:mn>2</m:mn>
          </m:msup>
          <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
           <m:mrow>
            <m:mi>sin</m:mi>
           </m:mrow>
           <m:mn>2</m:mn>
          </m:msup>
          <m:mi>x</m:mi>
         </m:mrow>
        <m:mo>)</m:mo></m:mrow>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:msup>
         <m:mrow>
          <m:mi>cos</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:msup>
        <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
         <m:mrow>
          <m:mi>sin</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:msup>
        <m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mn>2</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>4</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>4</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>4</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>4</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:msup>
         <m:mrow>
          <m:mi>sin</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:msup>
        <m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
         <m:mrow>
          <m:mi>cos</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:msup>
        <m:mi>x</m:mi>
       </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                                  </m:mtext><m:mo>=</m:mo><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
       <m:mrow>
        <m:mi>cos</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>

  </m:mtable>
 </m:mrow>
</m:math>
</para></solution></exercise>
   <exercise id="fs-id1768497" class="material-set-2"><problem id="fs-id1768498"><para id="fs-id1768499"> <m:math>
 <m:mrow>
  <m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:msup>
   <m:mrow>
    <m:mi>cos</m:mi>
   </m:mrow>
   <m:mn>3</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
   <m:mrow>
    <m:mi>sin</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mo>−</m:mo><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
 </m:mrow>
</m:math>
</para></problem></exercise>

   <para id="fs-id2478604">Untuk latihan berikut, sederhanakan ekspresi.</para>
   <exercise id="fs-id2478607"><problem id="fs-id2478608"><para id="fs-id2701767"> <m:math>
    <m:mrow>
     <m:mfrac>
      <m:mrow>
       <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mfrac>
          <m:mn>1</m:mn>
          <m:mn>2</m:mn>
         </m:mfrac>
         <m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:mfrac>
           <m:mn>1</m:mn>
           <m:mn>8</m:mn>
          </m:mfrac>
          <m:mi>x</m:mi>
         </m:mrow>
         <m:mo>)</m:mo></m:mrow>
      </m:mrow>
      <m:mrow>
       <m:mn>1</m:mn><m:mo>−</m:mo><m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mfrac>
          <m:mn>1</m:mn>
          <m:mn>8</m:mn>
         </m:mfrac>
         <m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:mfrac>
           <m:mn>1</m:mn>
           <m:mn>2</m:mn>
          </m:mfrac>
          <m:mi>x</m:mi>
         </m:mrow>
         <m:mo>)</m:mo></m:mrow>
      </m:mrow>
     </m:mfrac>

    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id3012619">
     <para id="fs-id3012621"> <m:math>
      <m:mrow>
       <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mfrac>
          <m:mn>5</m:mn>
          <m:mn>8</m:mn>
         </m:mfrac>
         <m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow>
      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>


   <para id="fs-id3511325">Untuk latihan berikut, tentukan nilai eksak.</para>
      <exercise id="fs-id3511328"><problem id="fs-id3511329"><para id="fs-id3511330"> <m:math>
 <m:mrow>
  <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:msup>
     <m:mrow>
      <m:mi>sin</m:mi>
     </m:mrow>
     <m:mrow>
      <m:mo>−</m:mo><m:mn>1</m:mn>
     </m:mrow>
    </m:msup>
    <m:mrow><m:mo>(</m:mo>
     <m:mn>0</m:mn>
    <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:msup>
     <m:mrow>
      <m:mi>cos</m:mi>
     </m:mrow>
     <m:mrow>
      <m:mo>−</m:mo><m:mn>1</m:mn>
     </m:mrow>
    </m:msup>
    <m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mfrac>
       <m:mn>1</m:mn>
       <m:mn>2</m:mn>
      </m:mfrac>

     </m:mrow>
    <m:mo>)</m:mo></m:mrow>
   </m:mrow>
  <m:mo>)</m:mo></m:mrow>
 </m:mrow>
</m:math>
</para></problem></exercise>
   <exercise id="fs-id3511333"><problem id="fs-id3511334"><para id="fs-id3511335"> <m:math>
 <m:mrow>
  <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:msup>
     <m:mrow>
      <m:mi>sin</m:mi>
     </m:mrow>
     <m:mrow>
      <m:mo>−</m:mo><m:mn>1</m:mn>
     </m:mrow>
    </m:msup>
    <m:mrow><m:mo>(</m:mo>
     <m:mn>0</m:mn>
    <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:msup>
     <m:mrow>
      <m:mi>sin</m:mi>
     </m:mrow>
     <m:mrow>
      <m:mo>−</m:mo><m:mn>1</m:mn>
     </m:mrow>
    </m:msup>
    <m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mfrac>
       <m:mn>1</m:mn>
       <m:mn>2</m:mn>
      </m:mfrac>

     </m:mrow>
    <m:mo>)</m:mo></m:mrow>
   </m:mrow>
  <m:mo>)</m:mo></m:mrow>
 </m:mrow>
</m:math>
</para></problem>
    <solution id="fs-id2633134">
     <para id="fs-id2633136"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:msqrt>
          <m:mn>3</m:mn>
         </m:msqrt>

        </m:mrow>
        <m:mn>3</m:mn>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>

  </section><section id="fs-id1995856"><title><link document="m49396">Rumus Sudut Ganda, Sudut Setengah, dan Reduksi Pangkat</link></title><para id="fs-id1995862">Untuk latihan berikut, tentukan nilai eksak.</para>
   <exercise id="fs-id1995865"><problem id="fs-id1995866"><para id="fs-id1995867">Tentukan <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>θ</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>, </m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>θ</m:mi>
       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo>
    </m:mrow>
   </m:math> dan <m:math>
    <m:mrow>
     <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>θ</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow>    </m:mrow>
   </m:math> jika diketahui <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>θ</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac>
      <m:mn>1</m:mn>
      <m:mn>3</m:mn>
     </m:mfrac>
         </m:mrow>
   </m:math> dan <m:math>
    <m:mrow>
     <m:mi>θ</m:mi>    </m:mrow>
   </m:math> berada pada interval <m:math>
    <m:mrow>
     <m:mrow><m:mo>[</m:mo> <m:mrow>
      <m:mfrac>
       <m:mi>π</m:mi>
       <m:mn>2</m:mn>
      </m:mfrac>
      <m:mo>,</m:mo><m:mi>π</m:mi>
     </m:mrow> <m:mo>]</m:mo></m:mrow><m:mo>.</m:mo>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id1681784"><problem id="fs-id1681785"><para id="fs-id1681786">Tentukan <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>θ</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>, </m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mn>2</m:mn><m:mi>θ</m:mi>
       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo>
    </m:mrow>
   </m:math> dan <m:math>
    <m:mrow>
     <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>θ</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow>    </m:mrow>
   </m:math> jika diketahui <m:math>
    <m:mrow>
     <m:mi>sec</m:mi><m:mspace width="0.3em" /><m:mi>θ</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac>
      <m:mn>5</m:mn>
      <m:mn>3</m:mn>
     </m:mfrac>
         </m:mrow>
   </m:math> dan <m:math>
    <m:mrow>
     <m:mi>θ</m:mi>    </m:mrow>
   </m:math> berada pada interval <m:math>
    <m:mrow>
     <m:mrow><m:mo>[</m:mo> <m:mrow>
      <m:mfrac>
       <m:mi>π</m:mi>
       <m:mn>2</m:mn>
      </m:mfrac>
      <m:mo>,</m:mo><m:mi>π</m:mi>
     </m:mrow> <m:mo>]</m:mo></m:mrow><m:mo>.</m:mo>
    </m:mrow>
   </m:math>
   </para></problem>
   <solution id="fs-id1362528">
    <para id="fs-id1362530"> <m:math>
     <m:mrow>
      <m:mo>−</m:mo><m:mfrac>
       <m:mrow>
        <m:mn>24</m:mn>
       </m:mrow>
       <m:mrow>
        <m:mn>25</m:mn>
       </m:mrow>
      </m:mfrac>
      <m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac>
       <m:mn>7</m:mn>
       <m:mrow>
        <m:mn>25</m:mn>
       </m:mrow>
      </m:mfrac>
      <m:mo>,</m:mo><m:mfrac>
       <m:mrow>
        <m:mn>24</m:mn>
       </m:mrow>
       <m:mn>7</m:mn>
      </m:mfrac>

     </m:mrow>
    </m:math>
    </para>
</solution></exercise>
   <exercise id="fs-id1362590"><problem id="fs-id1362591"><para id="fs-id1362592"> <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>7</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>8</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id3654262"><problem id="fs-id3654263"><para id="fs-id3654264"> <m:math>
    <m:mrow>
     <m:mi>sec</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>3</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>8</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id3654300">
     <para id="fs-id3654303"> <m:math>
      <m:mrow>
       <m:msqrt>
        <m:mrow>
         <m:mn>2</m:mn><m:mrow><m:mo>(</m:mo>
          <m:mrow>
           <m:mn>2</m:mn><m:mo>+</m:mo><m:msqrt>
            <m:mn>2</m:mn>
           </m:msqrt>

          </m:mrow>
          <m:mo>)</m:mo></m:mrow>
        </m:mrow>
       </m:msqrt>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>



   <para id="fs-id1490815">Untuk latihan berikut, gunakan <link target-id="Figure_07_07_201" /> untuk menentukan besaran yang diminta.</para><figure id="Figure_07_07_201" class="small"><media id="fs-id1490825" alt="Gambar segitiga siku-siku. Panjang alasnya 24, tingginya belum diketahui, dan hipotenusanya 25. Sudut di hadapan alas diberi label alfa, sedangkan sudut lancip lainnya diberi label beta.">
     <image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_07_07_201.jpg" />
    </media>
   </figure><exercise id="fs-id1490834"><problem id="fs-id1490835"><para id="fs-id1490836"> <m:math>
 <m:mrow>
  <m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>β</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>β</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mi>tan</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>β</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>α</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>α</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mtext> dan </m:mtext><m:mi>tan</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>α</m:mi><m:mo stretchy="false">)</m:mo>
 </m:mrow>
</m:math>
</para></problem></exercise>
   <exercise id="fs-id2745537"><problem id="fs-id2745538"><para id="fs-id2745539"> <m:math>
 <m:mrow>
  <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mfrac>
     <m:mi>β</m:mi>
     <m:mn>2</m:mn>
    </m:mfrac>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mfrac>
     <m:mi>β</m:mi>
     <m:mn>2</m:mn>
    </m:mfrac>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mfrac>
     <m:mi>β</m:mi>
     <m:mn>2</m:mn>
    </m:mfrac>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mfrac>
     <m:mi>α</m:mi>
     <m:mn>2</m:mn>
    </m:mfrac>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mfrac>
     <m:mi>α</m:mi>
     <m:mn>2</m:mn>
    </m:mfrac>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mtext> dan </m:mtext><m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:mfrac>
     <m:mi>α</m:mi>
     <m:mn>2</m:mn>
    </m:mfrac>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow>
 </m:mrow>
</m:math>
</para></problem>
   <solution id="fs-id1961675">
    <para id="fs-id1961677"> <m:math>
     <m:mrow>
      <m:mfrac>
       <m:mrow>
        <m:msqrt>
         <m:mn>2</m:mn>
        </m:msqrt>

       </m:mrow>
       <m:mrow>
        <m:mn>10</m:mn>
       </m:mrow>
      </m:mfrac>
      <m:mo>,</m:mo><m:mfrac>
       <m:mrow>
        <m:mn>7</m:mn><m:msqrt>
         <m:mn>2</m:mn>
        </m:msqrt>

       </m:mrow>
       <m:mrow>
        <m:mn>10</m:mn>
       </m:mrow>
      </m:mfrac>
      <m:mo>,</m:mo><m:mfrac>
       <m:mn>1</m:mn>
       <m:mn>7</m:mn>
      </m:mfrac>
      <m:mo>,</m:mo><m:mfrac>
       <m:mn>3</m:mn>
       <m:mn>5</m:mn>
      </m:mfrac>
      <m:mo>,</m:mo><m:mfrac>
       <m:mn>4</m:mn>
       <m:mn>5</m:mn>
      </m:mfrac>
      <m:mo>,</m:mo><m:mfrac>
       <m:mn>3</m:mn>
       <m:mn>4</m:mn>
      </m:mfrac>

     </m:mrow>
    </m:math>
    </para>
</solution></exercise>

   <para id="fs-id2851603">Untuk latihan berikut, buktikan identitasnya.</para>
   <exercise id="fs-id2851606"><problem id="fs-id2851607"><para id="fs-id2851608"> <m:math>
    <m:mrow>
     <m:mfrac>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mn>2</m:mn><m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow>
      </m:mrow>
      <m:mrow>
       <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mn>2</m:mn><m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow>
      </m:mrow>
     </m:mfrac>
     <m:mo>=</m:mo><m:mi>cot</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>tan</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id2253493"><problem id="fs-id2253494"><para id="fs-id2253495"> <m:math>
 <m:mrow>
  <m:mi>cot</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>cot</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi>
 </m:mrow>
</m:math>
</para></problem>
   <solution id="fs-id2253554">
    <para id="fs-id2253556"> <m:math>
 <m:mrow>
  <m:mtable columnalign="left">
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow />
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mi>cot</m:mi><m:mi>x</m:mi><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mi>cot</m:mi><m:mi>x</m:mi><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                    </m:mtext><m:mo>=</m:mo><m:mi>cot</m:mi><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac>
       <m:mrow>
        <m:mi>cos</m:mi><m:mi>x</m:mi>
       </m:mrow>
       <m:mrow>
        <m:mi>sin</m:mi><m:mi>x</m:mi>
       </m:mrow>
      </m:mfrac>
      <m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mn>2</m:mn>
      </m:msup>
      <m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                    </m:mtext><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>sin</m:mi><m:mi>x</m:mi><m:mi>cos</m:mi><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>cot</m:mi><m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>                    </m:mtext><m:mo>=</m:mo><m:mo>−</m:mo><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>cot</m:mi><m:mi>x</m:mi>
     </m:mrow>
    </m:mtd>
   </m:mtr>

  </m:mtable>
 </m:mrow>
</m:math>
</para></solution></exercise>

   <para id="fs-id1434712">Untuk latihan berikut, tulis ulang ekspresi tanpa pangkat.</para>
   <exercise id="fs-id1434715"><problem id="fs-id1434716"><para id="fs-id1434718"> <m:math>
 <m:mrow>
  <m:msup>
   <m:mrow>
    <m:mi>cos</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
   <m:mrow>
    <m:mi>sin</m:mi>
   </m:mrow>
   <m:mn>4</m:mn>
  </m:msup>
  <m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
 </m:mrow>
</m:math>
</para></problem></exercise>
   <exercise id="fs-id3991134"><problem id="fs-id3991135"><para id="fs-id3991136"> <m:math>
 <m:mrow>
  <m:msup>
   <m:mrow>
    <m:mi>tan</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mspace width="0.3em" /><m:msup>
   <m:mrow>
    <m:mi>sin</m:mi>
   </m:mrow>
   <m:mn>3</m:mn>
  </m:msup>
  <m:mi>x</m:mi>
 </m:mrow>
</m:math>
</para></problem>
    <solution id="fs-id3991176">
     <para id="fs-id3991178"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>10</m:mn><m:mi>sin</m:mi><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
          <m:mrow>
           <m:mn>3</m:mn><m:mi>x</m:mi>
          </m:mrow>
          <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
           <m:mrow>
            <m:mn>5</m:mn><m:mi>x</m:mi>
           </m:mrow>
           <m:mo>)</m:mo></m:mrow>
        </m:mrow>
        <m:mrow>
         <m:mn>8</m:mn><m:mrow><m:mo>(</m:mo>
          <m:mrow>
           <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
            <m:mrow>
             <m:mn>2</m:mn><m:mi>x</m:mi>
            </m:mrow>
            <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mn>1</m:mn>
          </m:mrow>
          <m:mo>)</m:mo></m:mrow>
        </m:mrow>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>

  </section><section id="fs-id1760577"><title><link document="m49397">Rumus Jumlah-ke-Hasil Kali dan Hasil Kali-ke-Jumlah</link></title><para id="fs-id1760583">Untuk latihan berikut, evaluasi hasil kali pada ekspresi yang diberikan dengan menggunakan jumlah atau selisih dua fungsi. Tuliskan jawaban eksak.</para>
   <exercise id="fs-id1760587"><problem id="fs-id1760588"><para id="fs-id1760589"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mi>π</m:mi>
        <m:mn>3</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mspace width="0.5em" /><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mi>π</m:mi>
         <m:mn>4</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id2888234"><problem id="fs-id2888235"><para id="fs-id2888236"> <m:math>
    <m:mrow>
     <m:mn>2</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>2</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>3</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mspace width="0.5em" /><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:mn>5</m:mn><m:mi>π</m:mi>
         </m:mrow>
         <m:mn>6</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2765399">
     <para id="fs-id2765402"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:msqrt>
          <m:mn>3</m:mn>
         </m:msqrt>

        </m:mrow>
        <m:mn>2</m:mn>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2765427"><problem id="fs-id2765428"><para id="fs-id2765429"> <m:math>
    <m:mrow>
     <m:mn>2</m:mn><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mi>π</m:mi>
        <m:mn>5</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mspace width="0.5em" /><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mi>π</m:mi>
         <m:mn>3</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem></exercise>


   <para id="fs-id2765484">Untuk latihan berikut, evaluasi jumlah dengan menggunakan rumus hasil kali. Tuliskan jawaban eksak.</para>

   <exercise id="fs-id2765487"><problem id="fs-id2765488"><para id="fs-id2765489"> <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mi>π</m:mi>
        <m:mrow>
         <m:mn>12</m:mn>
        </m:mrow>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:mn>7</m:mn><m:mi>π</m:mi>
         </m:mrow>
         <m:mrow>
          <m:mn>12</m:mn>
         </m:mrow>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id1880649">
     <para id="fs-id1880652"> <m:math>
      <m:mrow>
       <m:mo>−</m:mo><m:mfrac>
        <m:mrow>
         <m:msqrt>
          <m:mn>2</m:mn>
         </m:msqrt>

        </m:mrow>
        <m:mn>2</m:mn>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id1880679"><problem id="fs-id1880680"><para id="fs-id1880681"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>5</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mrow>
         <m:mn>12</m:mn>
        </m:mrow>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:mn>7</m:mn><m:mi>π</m:mi>
         </m:mrow>
         <m:mrow>
          <m:mn>12</m:mn>
         </m:mrow>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
    </m:mrow>
   </m:math>
   </para></problem></exercise>


   <para id="fs-id2186235">Untuk latihan berikut, ubah fungsi dari bentuk hasil kali menjadi jumlah atau dari jumlah menjadi hasil kali.</para>
   <exercise id="fs-id2186238"><problem id="fs-id2186239"><para id="fs-id2186240"> <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2186275">
     <para id="fs-id2186277"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mn>1</m:mn>
        <m:mn>2</m:mn>
       </m:mfrac>
       <m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow>
      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id1973243"><problem id="fs-id1973244"><para id="fs-id1973245"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id1973280"><problem id="fs-id1973281"><para id="fs-id1973282"> <m:math>
    <m:mrow>
     <m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2020645">
     <para id="fs-id2020648"> <m:math>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mfrac>
          <m:mrow>
           <m:mn>13</m:mn>
          </m:mrow>
          <m:mn>2</m:mn>
         </m:mfrac>
         <m:mi>x</m:mi>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow><m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
         <m:mrow>
          <m:mfrac>
           <m:mn>9</m:mn>
           <m:mn>2</m:mn>
          </m:mfrac>
          <m:mi>x</m:mi>
         </m:mrow>
         <m:mo>)</m:mo></m:mrow>
      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2020713"><problem id="fs-id2020714"><para id="fs-id2020715"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem></exercise>

  </section><section id="fs-id2042633"><title><link document="m49398">Menyelesaikan Persamaan Trigonometri</link></title><para id="fs-id2042639">Untuk latihan berikut, tentukan semua solusi eksak pada interval <m:math>
    <m:mrow>
     <m:mrow><m:mo>[</m:mo> <m:mrow>
      <m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi>
     </m:mrow> <m:mo>)</m:mo></m:mrow><m:mo>.</m:mo>
    </m:mrow>
   </m:math>
   </para>
   <exercise id="fs-id2042673"><problem id="fs-id2042674"><para id="fs-id2042675"> <m:math>
    <m:mrow>
     <m:mi>tan</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2042697">
     <para id="fs-id2042700"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>3</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>4</m:mn>
       </m:mfrac>
       <m:mo>,</m:mo><m:mfrac>
        <m:mrow>
         <m:mn>7</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>4</m:mn>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id1574962"><problem id="fs-id1574964"><para id="fs-id1574965"> <m:math>
    <m:mrow>
     <m:mn>2</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:msqrt>
      <m:mn>2</m:mn>
     </m:msqrt>
     <m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem></exercise>

   <para id="fs-id1575002">Untuk latihan berikut, tentukan semua solusi eksak pada interval <m:math>
    <m:mrow>
     <m:mrow><m:mo>[</m:mo> <m:mrow>
      <m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi>
     </m:mrow> <m:mo>)</m:mo></m:mrow><m:mo>.</m:mo>
    </m:mrow>
   </m:math>
   </para>
   <exercise id="fs-id1575036"><problem id="fs-id1575037"><para id="fs-id1575038"> <m:math>
    <m:mrow>
     <m:mn>2</m:mn><m:mspace width="0.5em" /><m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>−</m:mo><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2237012">
     <para id="fs-id2237014"> <m:math>
      <m:mrow>
       <m:mn>0</m:mn><m:mo>,</m:mo><m:mfrac>
        <m:mi>π</m:mi>
        <m:mn>6</m:mn>
       </m:mfrac>
       <m:mo>,</m:mo><m:mfrac>
        <m:mrow>
         <m:mn>5</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>6</m:mn>
       </m:mfrac>
       <m:mo>,</m:mo><m:mi>π</m:mi>
      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2237061"><problem id="fs-id2237062"><para id="fs-id2237063"> <m:math>
    <m:mrow>
     <m:msup>
      <m:mrow>
       <m:mi>cos</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>−</m:mo><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id2237103"><problem id="fs-id2237104"><para id="fs-id2237105"> <m:math>
    <m:mrow>
     <m:mn>2</m:mn><m:mspace width="0.5em" /><m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2119515">
     <para id="fs-id2119517"> <m:math>
      <m:mrow>
       <m:mfrac>
        <m:mrow>
         <m:mn>3</m:mn><m:mi>π</m:mi>
        </m:mrow>
        <m:mn>2</m:mn>
       </m:mfrac>

      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>
   <exercise id="fs-id2119542"><problem id="fs-id2119543"><para id="fs-id2119544"> <m:math>
    <m:mrow>
     <m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mn>2</m:mn><m:mi>x</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id2909207"><problem id="fs-id2909208"><para id="fs-id2909209"> <m:math>
    <m:mrow>
     <m:mfrac>
      <m:mn>1</m:mn>
      <m:mrow>
       <m:msup>
        <m:mrow>
         <m:mi>sec</m:mi>
        </m:mrow>
        <m:mn>2</m:mn>
       </m:msup>
       <m:mi>x</m:mi>
      </m:mrow>
     </m:mfrac>
     <m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mspace width="0.5em" /><m:msup>
      <m:mrow>
       <m:mi>cos</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2909289">
     <para id="fs-id2909291">Tidak ada solusi</para>
    </solution></exercise>


   <para id="fs-id2909295">Untuk latihan berikut, sederhanakan persamaan secara aljabar sejauh mungkin. Kemudian gunakan kalkulator untuk menentukan solusi pada interval <m:math>
    <m:mrow>
     <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo>    </m:mrow>
   </m:math> Bulatkan hingga empat tempat desimal.</para>
   <exercise id="fs-id2062530"><problem id="fs-id2062531"><para id="fs-id2062532"> <m:math>
    <m:mrow>
     <m:msqrt>
      <m:mn>3</m:mn>
     </m:msqrt><m:mspace width="0.5em" />
     <m:msup>
      <m:mrow>
       <m:mi>cot</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>+</m:mo><m:mi>cot</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id2062574"><problem id="fs-id2062575"><para id="fs-id2062576"> <m:math>
    <m:mrow>
     <m:msup>
      <m:mrow>
       <m:mi>csc</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mspace width="0.3em" /><m:mi>csc</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id2062617">
     <para id="fs-id2062620"> <m:math>
      <m:mrow>
       <m:mn>0.2527</m:mn><m:mo>,</m:mo><m:mn>2.8889</m:mn><m:mo>,</m:mo><m:mn>4.7124</m:mn>
      </m:mrow>
     </m:math>
     </para>
    </solution></exercise>

   <para id="fs-id3852824">Untuk latihan berikut, gambarkan kedua ruas persamaan untuk menentukan titik-titik nol pada interval <m:math>
    <m:mrow>
     <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo>
    </m:mrow>
   </m:math>
   </para>
   <exercise id="fs-id3852854"><problem id="fs-id3852855"><para id="fs-id3852856"> <m:math>
    <m:mrow>
     <m:mn>20</m:mn><m:mspace width="0.5em" /><m:msup>
      <m:mrow>
       <m:mi>cos</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>21</m:mn><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>0</m:mn>
    </m:mrow>
   </m:math>
   </para></problem></exercise>
   <exercise id="fs-id3852900"><problem id="fs-id3852901"><para id="fs-id3852902"> <m:math>
    <m:mrow>
     <m:msup>
      <m:mrow>
       <m:mi>sec</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
     <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mspace width="0.3em" /><m:mi>sec</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>15</m:mn>
    </m:mrow>
   </m:math>
   </para></problem>
    <solution id="fs-id1575698">
     <para id="fs-id1575700"> <m:math>
      <m:mrow>
       <m:mn>1.3694</m:mn></m:mrow></m:math>, <m:math><m:mn>1.9106</m:mn></m:math>, <m:math><m:mn>4.3726</m:mn></m:math>, <m:math><m:mn>4.9137</m:mn>
     </m:math>
     </para>
    </solution></exercise></section><section id="fs-id1575734"><title><link document="m49399">Pemodelan dengan Persamaan Trigonometri</link></title><para id="fs-id1575740">Untuk latihan berikut, plot titik-titiknya dan tentukan salah satu rumus yang mungkin untuk nilai-nilai trigonometri pada tabel yang diberikan.</para>
   <exercise id="fs-id1575744">
<problem id="fs-id1575745"><table id="fs-id1575746" summary="Dua kolom, tujuh baris. Tabel memuat pasangan terurut berikut: (x,y), (0,1), (1,6), (2,11), (3,6), (4,1), (5,6)." class="unnumbered"><label />
    <title />
    <tgroup cols="2">
          <tbody>
      <row>
       <entry align="center"><emphasis> <m:math>
        <m:mi>x</m:mi>
       </m:math>
       </emphasis></entry><entry align="center"><emphasis> <m:math>
        <m:mi>y</m:mi>
       </m:math> </emphasis></entry>
    </row>
    <row>
       <entry align="center"> <m:math>
        <m:mn>0</m:mn>
       </m:math>
       </entry><entry align="center"> <m:math>
        <m:mrow>
         <m:mn>1</m:mn>
        </m:mrow>
       </m:math>
       </entry>
    </row>
    <row>
       <entry align="center"> <m:math>
        <m:mn>1</m:mn>
       </m:math> </entry> <entry align="center"> <m:math>
        <m:mn>6</m:mn>
       </m:math> </entry>
    </row>
    <row>
       <entry align="center"> <m:math>
        <m:mn>2</m:mn>
       </m:math> </entry><entry align="center"> <m:math>
        <m:mn>11</m:mn>
       </m:math> </entry>
    </row>
    <row>
       <entry align="center"> <m:math>
        <m:mn>3</m:mn>
       </m:math> </entry><entry align="center"> <m:math>
        <m:mo>−</m:mo><m:mn>6</m:mn>
       </m:math> </entry>
    </row>
    <row>
       <entry align="center"> <m:math>
        <m:mn>4</m:mn>
       </m:math> </entry><entry align="center"> <m:math>
        <m:mo>−</m:mo><m:mn>1</m:mn>
       </m:math> </entry>
    </row>
    <row>
       <entry align="center"> <m:math>
        <m:mn>5</m:mn>
       </m:math> </entry> <entry align="center"> <m:math>
        <m:mn>6</m:mn>
       </m:math> </entry>
      </row>
    </tbody>

    </tgroup>
   </table></problem></exercise><exercise id="fs-id1742753"><problem id="fs-id1742754"><table id="fs-id1742756" summary="Dua kolom, tujuh baris. Tabel memuat pasangan terurut berikut: (x,y), (0,-2), (1,1), (2,-2), (3,-5), (4,-2), (5,1)." class="unnumbered"><label />
    <title />
    <tgroup cols="2">
          <tbody>
      <row>
       <entry align="center"><emphasis> <m:math>
        <m:mi>x</m:mi>
       </m:math>
       </emphasis></entry><entry align="center"><emphasis> <m:math>
        <m:mi>y</m:mi>
       </m:math> </emphasis></entry>
 </row>
<row>
       <entry align="center"> <m:math>
        <m:mn>0</m:mn>
       </m:math>
       </entry><entry align="center"> <m:math>
        <m:mrow>
         <m:mo>−</m:mo><m:mn>2</m:mn>
        </m:mrow>
       </m:math>
       </entry>
 </row>
<row>
       <entry align="center"> <m:math>
        <m:mn>1</m:mn>
       </m:math> </entry> <entry align="center"> <m:math>
        <m:mn>1</m:mn>
       </m:math> </entry>
 </row>
<row>
       <entry align="center"> <m:math>
        <m:mn>2</m:mn>
       </m:math> </entry><entry align="center"> <m:math>
        <m:mo>−</m:mo><m:mn>2</m:mn>
       </m:math> </entry>
 </row>
<row>
       <entry align="center"> <m:math>
        <m:mn>3</m:mn>
       </m:math> </entry><entry align="center"> <m:math>
        <m:mo>−</m:mo><m:mn>5</m:mn>
       </m:math> </entry>
 </row>
<row>
       <entry align="center"> <m:math>
        <m:mn>4</m:mn>
       </m:math> </entry><entry align="center"> <m:math>
        <m:mo>−</m:mo><m:mn>2</m:mn>
       </m:math> </entry>
 </row>
<row>
       <entry align="center"> <m:math>
        <m:mn>5</m:mn>
       </m:math> </entry> <entry align="center"> <m:math>
        <m:mn>1</m:mn>
       </m:math> </entry>
      </row>
   </tbody>

    </tgroup>
   </table></problem>
   <solution id="fs-id2697677">
    <para id="fs-id2697679"> <m:math>
     <m:mrow>
      <m:mn>3</m:mn><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mrow>
          <m:mi>x</m:mi><m:mi>π</m:mi>
         </m:mrow>
         <m:mn>2</m:mn>
        </m:mfrac>

       </m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mn>2</m:mn>
     </m:mrow>
    </m:math>
    </para>
</solution></exercise><exercise id="fs-id3991274"><problem id="fs-id3991276"><table id="fs-id3991277" summary="Dua kolom, delapan baris. Tabel memuat pasangan terurut berikut: (x,y), (-3, 3 + 2rad2), (-2, 3), (-1, 2rad2 - 1), (0,1), (1, 3 - 2rad2), (2, -1), (3, -1 - 2rad2)." class="unnumbered"><label />
<tgroup cols="2">      <tbody>
       <row>
        <entry align="center"><emphasis> <m:math>
         <m:mi>x</m:mi>
        </m:math>
        </emphasis></entry><entry align="center"><emphasis> <m:math>
         <m:mi>y</m:mi>
        </m:math> </emphasis></entry>
 </row>
<row>
        <entry align="center"> <m:math>
          <m:mrow>
           <m:mo>−</m:mo><m:mn>3</m:mn>
          </m:mrow>
         </m:math>

        </entry><entry align="center"> <m:math>
         <m:mrow>
          <m:mn>3</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:msqrt>
           <m:mn>2</m:mn>
          </m:msqrt>

         </m:mrow>
        </m:math>

        </entry>
 </row>
<row>
        <entry align="center"> <m:math>
         <m:mo>−</m:mo><m:mn>2</m:mn>
        </m:math> </entry><entry align="center"> <m:math>
         <m:mn>3</m:mn>
        </m:math> </entry>
 </row>
<row>
        <entry align="center"> <m:math>
         <m:mo>−</m:mo><m:mn>1</m:mn>
        </m:math> </entry> <entry align="center"> <m:math>
         <m:mrow>
          <m:mn>2</m:mn><m:msqrt>
           <m:mn>2</m:mn>
          </m:msqrt>
          <m:mo>−</m:mo><m:mn>1</m:mn>
         </m:mrow>
        </m:math>
        </entry>
 </row>
<row>
        <entry align="center"> <m:math>
         <m:mn>0</m:mn>
        </m:math> </entry>   <entry align="center"> <m:math>
         <m:mn>1</m:mn>
        </m:math> </entry>
 </row>
<row>
        <entry align="center"> <m:math>
         <m:mn>1</m:mn>
        </m:math> </entry><entry align="center"> <m:math>
         <m:mrow>
          <m:mn>3</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:msqrt>
           <m:mn>2</m:mn>
          </m:msqrt>

         </m:mrow>
        </m:math>
        </entry>
 </row>
<row>

        <entry align="center"> <m:math>
         <m:mn>2</m:mn>
        </m:math> </entry><entry align="center"> <m:math>
         <m:mo>−</m:mo><m:mn>1</m:mn>
        </m:math> </entry>
 </row>
<row>

        <entry align="center"> <m:math>
         <m:mn>3</m:mn>
        </m:math> </entry>  <entry align="center"> <m:math>
         <m:mrow>
          <m:mn>−1</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:msqrt>
           <m:mn>2</m:mn>
          </m:msqrt>

         </m:mrow>
        </m:math>
        </entry>

       </row>
      </tbody>



</tgroup>
</table></problem></exercise><exercise id="fs-id2112202" class="material-set-2"><problem id="fs-id2112203"><para id="fs-id2112204">Seorang laki-laki dengan ketinggian mata 6 kaki di atas tanah berdiri 3 kaki dari kaki tangga vertikal setinggi 15 kaki. Jika ia memandang puncak tangga, pada sudut berapa di atas garis horizontal ia memandang?</para></problem>
   <solution id="fs-id2112209">
    <para id="fs-id2112212"> <m:math>
     <m:mrow>
      <m:msup>
       <m:mrow>
        <m:mn>71.6</m:mn>
       </m:mrow>
       <m:mo>∘</m:mo>
      </m:msup>

     </m:mrow>
    </m:math>
    </para>
</solution></exercise>
   <exercise id="fs-id2112235" class="material-set-2"><problem id="fs-id2112236"><para id="fs-id2112237">Dengan menggunakan tangga pada latihan sebelumnya, seorang pekerja konstruksi setinggi 6 kaki berdiri di puncak tangga dan memandang kaki laki-laki yang berdiri di bawah. Berapa sudut pandangnya dari garis horizontal?</para></problem></exercise>

   <para id="fs-id2112242">Untuk latihan berikut, susun fungsi yang memodelkan perilaku yang dijelaskan.</para>
   <exercise id="fs-id2112246" class="material-set-2"><problem id="fs-id2112247"><para id="fs-id2112248">Populasi lemming bervariasi dengan nilai terendah tahunan 500 ekor pada Maret. Jika populasi rata-rata tahunannya 950 ekor, tuliskan fungsi yang memodelkan populasi terhadap <m:math>
 <m:mrow>
  <m:mi>t</m:mi><m:mo>,</m:mo>
 </m:mrow>
</m:math> yaitu nomor bulan.</para></problem>
   <solution id="fs-id3639873">
    <para id="fs-id3639875"> <m:math>
     <m:mrow>
      <m:mi>P</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>950</m:mn><m:mo>−</m:mo><m:mn>450</m:mn><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mfrac>
         <m:mi>π</m:mi>
         <m:mn>6</m:mn>
        </m:mfrac>
        <m:mi>t</m:mi>
       </m:mrow>
       <m:mo>)</m:mo></m:mrow>
     </m:mrow>
    </m:math>
    </para>
</solution></exercise>
   <exercise id="fs-id3639932" class="material-set-2"><problem id="fs-id3639933"><para id="fs-id3639934">Suhu harian di gurun bisa sangat ekstrem. Jika suhu bervariasi dari <m:math>
    <m:mrow>
     <m:mn>90</m:mn><m:mtext>°F</m:mtext>    </m:mrow>
   </m:math> hingga <m:math>
    <m:mrow>
     <m:mn>30</m:mn><m:mtext>°F</m:mtext>    </m:mrow>
   </m:math> dan suhu rata-rata harian pertama kali terjadi pukul 10.00, tuliskan fungsi yang memodelkan perilaku ini.</para></problem></exercise>

   <para id="fs-id3639974">Untuk latihan berikut, tentukan amplitudo, frekuensi, dan periode persamaan yang diberikan.</para>
   <exercise id="fs-id3639978"><problem id="fs-id3639979"><para id="fs-id3639980"> <m:math>
    <m:mrow>
     <m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mspace width="0.3em" /><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mi>π</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem>
   <solution id="fs-id1783782">
    <para id="fs-id1783784">Amplitudo: 3, periode: 2, frekuensi: <m:math>
     <m:mrow>
      <m:mfrac>
       <m:mn>1</m:mn>
       <m:mn>2</m:mn>
      </m:mfrac>

     </m:mrow>
    </m:math>
     Hz</para>
</solution></exercise>
   <exercise id="fs-id1783804"><problem id="fs-id1783805"><para id="fs-id1783806"> <m:math>
    <m:mrow>
     <m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−2</m:mn><m:mspace width="0.3em" /><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mi>π</m:mi><m:mo stretchy="false">)</m:mo>
    </m:mrow>
   </m:math>
   </para></problem></exercise>

   <para id="fs-id1783841">Untuk latihan berikut, modelkan perilaku yang dijelaskan dan tentukan nilai yang diminta.</para>
   <exercise id="fs-id1783845" class="material-set-2"><problem id="fs-id1783846"><para id="fs-id1783847">Spesies ikan mas invasif diperkenalkan ke Danau Freshwater. Mula-mula terdapat 100 ekor ikan mas di danau dan populasinya bervariasi secara musiman sebesar 20 ekor. Jika pada tahun ke-5 terdapat 625 ekor ikan mas, tentukan fungsi yang memodelkan populasi ikan mas terhadap <m:math>
    <m:mrow>
     <m:mi>t</m:mi><m:mo>,</m:mo>
    </m:mrow>
   </m:math> yaitu jumlah tahun sejak sekarang.</para></problem>
   <solution id="fs-id1783866">
    <para id="fs-id1783868"> <m:math>
     <m:mrow>
      <m:mi>C</m:mi><m:mo stretchy="false">(</m:mo><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>20</m:mn><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>π</m:mi><m:mi>t</m:mi><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>100</m:mn><m:msup>
       <m:mrow>
        <m:mo stretchy="false">(</m:mo><m:mn>1.4427</m:mn><m:mo stretchy="false">)</m:mo>
       </m:mrow>
       <m:mi>t</m:mi>
      </m:msup>

     </m:mrow>
    </m:math>
    </para>
</solution></exercise>
   <exercise id="fs-id1796373" class="material-set-2"><problem id="fs-id1796374"><para id="fs-id1796376">Populasi ikan asli Danau Freshwater rata-rata 2.500 ekor dan bervariasi secara musiman sebesar 100 ekor. Karena persaingan sumber daya dengan ikan mas invasif, populasi ikan asli diperkirakan berkurang 5% setiap tahun. Tentukan fungsi yang memodelkan populasi ikan asli terhadap <m:math>
    <m:mrow>
     <m:mi>t</m:mi><m:mo>,</m:mo>
    </m:mrow>
   </m:math> yaitu jumlah tahun sejak sekarang. Tentukan juga berapa tahun hingga populasi ikan mas melampaui populasi ikan asli.</para></problem></exercise>
  </section></section><section id="fs-id1796401" class="practice-test"><title>Tes Latihan</title><para id="fs-id1796408">Untuk latihan berikut, sederhanakan ekspresi yang diberikan.</para>
  <exercise id="fs-id1796411"><problem id="fs-id1796412"><para id="fs-id1796413"> <m:math>
   <m:mrow>
    <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mi>−</m:mi><m:mi>x</m:mi>
     </m:mrow>
     <m:mo>)</m:mo></m:mrow><m:mi>sin</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mspace width="0.3em" /><m:mi>cot</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
      <m:mrow>
       <m:mi>sin</m:mi>
      </m:mrow>
      <m:mn>2</m:mn>
     </m:msup>
    <m:mi>x</m:mi>
   </m:mrow>
  </m:math>
  </para></problem>
  <solution id="fs-id2602415">
   <para id="fs-id2602417"> 1 </para>
  </solution></exercise>
  <exercise id="fs-id2602421"><problem id="fs-id2602422"><para id="fs-id2602424"> <m:math>
   <m:mrow>
    <m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>−</m:mi><m:mi>sin</m:mi><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mi>cos</m:mi><m:mo stretchy="false">(</m:mo><m:mi>−</m:mi><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo>
   </m:mrow>
  </m:math>
  </para></problem></exercise>

  <para id="fs-id2575417">Untuk latihan berikut, tentukan nilai eksak.</para>
  <exercise id="fs-id2575420"><problem id="fs-id2575421"><para id="fs-id2575422"> <m:math>
   <m:mrow>
    <m:mi>cos</m:mi><m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mfrac>
       <m:mrow>
        <m:mn>7</m:mn><m:mi>π</m:mi>
       </m:mrow>
       <m:mrow>
        <m:mn>12</m:mn>
       </m:mrow>
      </m:mfrac>

     </m:mrow>
     <m:mo>)</m:mo></m:mrow>
   </m:mrow>
  </m:math>
  </para></problem>
  <solution id="fs-id2575462">
   <para id="fs-id2575464"> <m:math>
    <m:mrow>
     <m:mfrac>
      <m:mrow>
       <m:msqrt>
        <m:mn>2</m:mn>
       </m:msqrt>
       <m:mo>−</m:mo><m:msqrt>
        <m:mn>6</m:mn>
       </m:msqrt>

      </m:mrow>
      <m:mn>4</m:mn>
     </m:mfrac>

    </m:mrow>
   </m:math>
   </para>
  </solution></exercise>
  <exercise id="fs-id2575498"><problem id="fs-id2575499"><para id="fs-id2575500"> <m:math>
   <m:mrow>
    <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mfrac>
       <m:mrow>
        <m:mn>3</m:mn><m:mi>π</m:mi>
       </m:mrow>
       <m:mn>8</m:mn>
      </m:mfrac>

     </m:mrow>
     <m:mo>)</m:mo></m:mrow>
   </m:mrow>
  </m:math>
  </para></problem></exercise>
  <exercise id="fs-id1789843"><problem id="fs-id1789844"><para id="fs-id1789845"> <m:math>
 <m:mrow>
  <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mrow>
    <m:msup>
     <m:mrow>
      <m:mi>sin</m:mi>
     </m:mrow>
     <m:mrow>
      <m:mo>−</m:mo><m:mn>1</m:mn>
     </m:mrow>
    </m:msup>
    <m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mfrac>
       <m:mrow>
        <m:msqrt>
         <m:mn>2</m:mn>
        </m:msqrt>

       </m:mrow>
       <m:mn>2</m:mn>
      </m:mfrac>

     </m:mrow>
    <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:msup>
     <m:mrow>
      <m:mi>tan</m:mi>
     </m:mrow>
     <m:mrow>
      <m:mo>−</m:mo><m:mn>1</m:mn>
     </m:mrow>
    </m:msup>
    <m:msqrt>
     <m:mn>3</m:mn>
    </m:msqrt>

   </m:mrow>
  <m:mo>)</m:mo></m:mrow>
 </m:mrow>
</m:math>
</para></problem>
  <solution id="fs-id1789937">
   <para id="fs-id1789939"> <m:math>
    <m:mrow>
     <m:mo>−</m:mo>
      <m:mn>2</m:mn>
     <m:mo>−</m:mo><m:msqrt>
      <m:mn>3</m:mn>
     </m:msqrt>

    </m:mrow>
   </m:math>
   </para>
  </solution></exercise>
  <exercise id="fs-id2147196"><problem id="fs-id2147197"><para id="fs-id2147198"> <m:math>
   <m:mrow>
    <m:mn>2</m:mn><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
     <m:mrow>
      <m:mfrac>
       <m:mi>π</m:mi>
       <m:mn>4</m:mn>
      </m:mfrac>

     </m:mrow>
     <m:mo>)</m:mo></m:mrow><m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mfrac>
        <m:mi>π</m:mi>
        <m:mn>6</m:mn>
       </m:mfrac>

      </m:mrow>
      <m:mo>)</m:mo></m:mrow>
   </m:mrow>
  </m:math>
  </para></problem></exercise>

  <para id="fs-id2147252">Untuk latihan berikut, tentukan semua solusi eksak persamaan pada <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>π</m:mi><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo>
   </m:mrow>
  </m:math>
  </para>
  <exercise id="fs-id2147284"><problem id="fs-id2147285"><para id="fs-id2147286"> <m:math>
   <m:mrow>
    <m:msup>
     <m:mrow>
      <m:mi>cos</m:mi>
     </m:mrow>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mi>x</m:mi><m:mo>−</m:mo><m:msup>
     <m:mrow>
      <m:mi>sin</m:mi>
     </m:mrow>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>0</m:mn>
   </m:mrow>
  </m:math>
  </para></problem>
  <solution id="fs-id3065334">
   <para id="fs-id3065336"> <m:math>
    <m:mrow>
     <m:mn>0</m:mn><m:mo>,</m:mo><m:mi>π</m:mi>
    </m:mrow>
   </m:math>
   </para>
  </solution></exercise>
  <exercise id="fs-id3065353"><problem id="fs-id3065354"><para id="fs-id3065355"> <m:math>
 <m:mrow>
  <m:msup>
   <m:mrow>
    <m:mi>cos</m:mi>
   </m:mrow>
   <m:mn>2</m:mn>
  </m:msup>
  <m:mi>x</m:mi><m:mo>=</m:mo><m:mi>cos</m:mi><m:mspace width="0.3em" /><m:mi>x</m:mi></m:mrow>
</m:math>
</para></problem>
