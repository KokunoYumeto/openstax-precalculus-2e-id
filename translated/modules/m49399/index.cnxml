          </m:mrow>
         </m:msqrt>
         <m:mo>&#8722;</m:mo><m:mn>1</m:mn>
        </m:mrow>
        <m:mo>)</m:mo></m:mrow>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mi>&#960;</m:mi><m:mo>&#8722;</m:mo><m:msup>
       <m:mrow>
        <m:mi>sin</m:mi>
       </m:mrow>
       <m:mrow>
        <m:mo>&#8722;</m:mo><m:mn>1</m:mn>
       </m:mrow>
      </m:msup>
     <m:mrow><m:mo>(</m:mo>
