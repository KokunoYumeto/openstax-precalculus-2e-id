      <m:mrow>
       <m:mfrac>
        <m:mi>&#960;</m:mi>
        <m:mn>6</m:mn>
       </m:mfrac>
       <m:mi>t</m:mi>
      </m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mn>108</m:mn><m:mo>+</m:mo><m:mfrac>
       <m:mn>1</m:mn>
