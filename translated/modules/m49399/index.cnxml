     </m:math> </entry><entry align="center"> <m:math>
      <m:mrow>
       <m:mn>10</m:mn>
      </m:mrow>
     </m:math> </entry>
 </row>
   </tbody>
  </tgroup>
 </table></problem></exercise>
<exercise id="fs-id2795267"><problem id="fs-id2795268"><table id="fs-id2795269" summary="Dua kolom, delapan baris. Tabel memuat pasangan terurut berikut: (x,y), (0,5), (1,-3), (2,5), (3,13), (4,5), (5,-3), (6,5)." class="unnumbered"><label />
