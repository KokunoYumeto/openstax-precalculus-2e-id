 <solution id="fs-id4012763">
  <para id="fs-id2467310"> <m:math>
<m:mi>y</m:mi><m:mo>=</m:mo>

  <m:mrow>
   <m:mi>tan</m:mi><m:mrow><m:mo>(</m:mo>
    <m:mrow>
     <m:mfrac>
      <m:mrow>
       <m:mi>x</m:mi><m:mi>π</m:mi>
      </m:mrow>
      <m:mn>8</m:mn>
     </m:mfrac>

    </m:mrow>
    <m:mo>)</m:mo></m:mrow>
  </m:mrow>
 </m:math>
 </para></solution></exercise>
<exercise id="fs-id2726280"><problem id="fs-id2726281"><table id="fs-id2760414" summary="Dua kolom, delapan baris. Tabel memuat pasangan terurut berikut: (x,y), (-3, -1 - rad2), (-2, -1), (-1, 1 - rad2), (0,0), (1, rad2 - 1), (2,1), (3, rad2 + 1)." class="unnumbered"><label />
