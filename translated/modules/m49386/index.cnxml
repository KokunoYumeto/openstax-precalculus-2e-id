<title>Pengantar Fungsi Periodik</title>
<metadata>
  <md:content-id>m49386</md:content-id>
  <md:title>Pengantar Fungsi Periodik</md:title>
  <md:abstract />
  <md:uuid>8988dff6-f836-4082-a85e-361ec0b56437</md:uuid>
