<row>
<entry align="center"> <m:math>
 <m:mrow>
  <m:mi mathvariant="bold">cos</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mi mathvariant="bold">x</m:mi>
  <m:mo>)</m:mo></m:mrow>
 </m:mrow>
</m:math> </entry>
<entry align="center"> <m:math>
 <m:mn>1</m:mn>
</m:math> </entry>
<entry align="center"> <m:math display="block">
 <m:mrow>
  <m:mfrac>
   <m:mrow>
    <m:msqrt>
     <m:mn>3</m:mn>
    </m:msqrt>

   </m:mrow>
   <m:mn>2</m:mn>
  </m:mfrac>

 </m:mrow>
</m:math> </entry>
