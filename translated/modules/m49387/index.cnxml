   <m:mrow>
    <m:mn>5</m:mn><m:mi>π</m:mi>
   </m:mrow>
   <m:mn>6</m:mn>
  </m:mfrac>

 </m:mrow>
</m:math> </entry>
<entry align="center"> <m:math>
 <m:mi>π</m:mi>
</m:math> </entry>
</row>
<row>
<entry align="center"><emphasis> <m:math>
 <m:mrow>
  <m:mi>sin</m:mi><m:mrow><m:mo>(</m:mo>
   <m:mi>x</m:mi>
  <m:mo>)</m:mo></m:mrow>
 </m:mrow>
</m:math> </emphasis></entry>
<entry align="center"> <m:math>
 <m:mn>0</m:mn>
</m:math> </entry>
<entry align="center"> <m:math>
 <m:mrow>
  <m:mfrac>
   <m:mn>1</m:mn>
   <m:mn>2</m:mn>
  </m:mfrac>

 </m:mrow>
</m:math> </entry>
